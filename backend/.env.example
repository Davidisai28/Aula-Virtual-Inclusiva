# Copiar a .env (ignorado). No pegar claves en archivos versionados.
PORT=3000
GOOGLE_DRIVE_FOLDER_ID=REEMPLAZAR_POR_ID_DE_CARPETA
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/cuenta-servicio.json
# Render: usar /etc/secrets/google-service-account.json en la variable anterior.
# Alternativa: GOOGLE_SERVICE_ACCOUNT_JSON solo en el panel privado del proveedor.
# NODE_ENV=production
# Publicacion bloqueada por defecto. No habilitar para material privado.
# ALLOW_PUBLIC_CATALOG=true
